{
  "name": "NightShadess24 Extensions (0.9 v8 to v9)",
  "private": true,
  "description": "Test version of the NightShadess24 repository: only the sources being fixed (now Comix), with the newest fixes first.",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "conformance": "npm run tsc && npm run lint:check && npm run format:check",
    "bundle": "paperback-cli bundle && node scripts/only-sources.mjs && node scripts/homepage.mjs",
    "serve": "paperback-cli serve",
    "dev": "paperback-cli serve --watch",
    "logcat": "paperback-cli logcat",
    "test": "paperback-cli test --noConsole --output ./bundles/tests.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@paperback/toolchain": "^1.0.0-alpha.92",
    "@paperback/types": "^1.0.0-alpha.92",
    "@types/chai": "^5.2.3",
    "chai": "^6.3.0",
    "cheerio": "^1.2.0",
    "fastest-levenshtein": "^1.0.16",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "stemmer": "^2.0.1",
    "typescript": "^7.0.2"
  }
}
