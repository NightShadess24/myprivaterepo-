{
  "name": "NightShadess24 Extensions (0.9)",
  "private": true,
  "description": "Paperback 0.9 extensions: Inkdex's General Extensions with a fixed Comix source, plus the sources of other open-source 0.9 repositories and the 0.8-only sources ported to 0.9 (credited on the homepage).",
  "type": "module",
  "scripts": {
    "tsc": "tsc",
    "lint": "oxlint --type-aware --fix",
    "lint:check": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "conformance": "npm run tsc && npm run lint:check && npm run format:check",
    "bundle": "node scripts/build.mjs",
    "serve": "paperback-cli serve",
    "dev": "paperback-cli serve --watch",
    "logcat": "paperback-cli logcat",
    "test": "paperback-cli test --noConsole --output ./bundles/tests.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@paperback/toolchain": "^1.0.0-alpha.92",
    "@paperback/types": "^1.0.0-alpha.92",
    "@types/chai": "^5.2.3",
    "chai": "^6.3.0",
    "cheerio": "^1.2.0",
    "cheerio-08": "npm:cheerio@1.0.0-rc.12",
    "entities": "8.1.0",
    "esbuild": "0.28.2",
    "fastest-levenshtein": "^1.0.16",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "stemmer": "^2.0.1",
    "typescript": "^7.0.2"
  }
}
